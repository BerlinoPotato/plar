[
  {
    "name": "PDF - Combine/Split",
    "runner": "{python_u} \"{script}\" --pdfA \"{pdfA}\" --pdfB \"{pdfB}\" --pattern \"{pattern}\" --output \"{output}\"",
    "script": "msrc/runner_combinepdfs.py",
    "inputs": [
      {
        "name": "pdfA",
        "type": "file",
        "label": "1st PDF [A]",
        "default": "data/pdf_sample/doc01.pdf",
        "choices": null,
        "required": true,
        "readonly": false
      },
      {
        "name": "pdfB",
        "type": "file",
        "label": "2nd PDF [B]",
        "default": "data/pdf_sample/doc02.pdf",
        "choices": null,
        "required": false,
        "readonly": false
      },
      {
        "name": "pattern",
        "type": "string",
        "label": "Mix Pattern",
        "default": "B,A2-5,B2,B0,B2,A7-4,A12",
        "choices": null,
        "required": false,
        "readonly": false
      },
      {
        "name": "output",
        "type": "file",
        "label": "Output PDF file",
        "default": "tmp/combined_<yyyymmddhhmmss>.pdf",
        "choices": null,
        "required": false,
        "readonly": false
      }
    ],
    "notes": "Combine up to two PDFs with page ranges\nUse Mix Patterns to describe how pdfs can will be combined, repeated or cross mixing are allowed!\nExample : B,A2-5,B2,B0,B2,A7-4,A12\nExample : B,A\nExample : A,B2\nExample : A3"
  },
  {
